---
import { NAV_LINKS } from "@/lib/constants/index";
import { cn } from "@/lib/utils";

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// Strip the base prefix and trailing slash for clean comparison
const stripBase = (path: string) => {
  const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
  let stripped = path;
  if (normalizedBase && stripped.startsWith(normalizedBase)) {
    stripped = stripped.slice(normalizedBase.length);
  }
  if (stripped.endsWith("/") && stripped !== "/") {
    stripped = stripped.slice(0, -1);
  }
  return stripped || "/";
};

const currentPath = stripBase(pathname);

const isActive = (path: string) => {
  const strippedPath = stripBase(path);
  if (currentPath === strippedPath) return true;
  // Match sub-paths (e.g. /articles/foo matches /articles)
  if (strippedPath !== "/" && currentPath.startsWith(strippedPath + "/")) return true;
  return false;
};
---

<div class="flex items-center justify-center gap-4">
  {
    NAV_LINKS.map(link => (
      <a
        href={link.href}
        class={cn(
          "group relative flex flex-col items-center justify-center text-xs font-medium text-foreground/70 duration-150 hover:text-primary lg:text-sm"
        )}
      >
        <span class={cn("mb", isActive(link.href) && "text-primary")}>
          {link.label}
        </span>

        <span
          class={cn(
            "absolute -bottom-px h-[1px] rounded-full bg-primary transition-all duration-150",
            isActive(link.href) ? "w-full" : "w-0",
            "group-hover:w-full"
          )}
        />
      </a>
    ))
  }
</div>
