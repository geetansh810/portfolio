---
import ModeToggle from "@/components/mode-toggle.astro";
import NavLinks from "./nav-links.astro";
import { PROFILE_INFO } from "@/lib/constants/profile";
import { basePath } from "@/lib/utils";

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<nav
  class:list={[
    "screen-line-after sticky top-0 z-50 w-full bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60",
    className,
  ]}
>
  <div
    class="mx-auto flex flex-col sm:flex-row max-w-3xl items-center justify-between px-4 py-2 sm:py-1 md:border-x gap-y-2 sm:gap-y-0"
  >
    <a href={basePath("/")}>
      <h1 class="text-xl font-bold text-center py-1">{PROFILE_INFO.logo}</h1>
    </a>

    <div class="flex items-center justify-center gap-4">
      <NavLinks />
      <ModeToggle />
    </div>
  </div>
</nav>
