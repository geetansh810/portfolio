---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="relative flex w-full h-28 sm:size-20 md:size-24 shrink-0 items-center justify-center border-b sm:border-b-0 sm:border-r bg-muted/10 overflow-hidden select-none">
  {
    id === "architect-io" && (
      <svg viewBox="0 0 100 100" class="w-full h-full text-muted-foreground group-hover:text-primary transition-colors duration-300">
        <defs>
          <pattern id="grid-architect" width="10" height="10" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1" class="fill-muted-foreground/15 dark:fill-muted-foreground/10" />
          </pattern>
        </defs>
        
        <!-- Background grid -->
        <rect width="100" height="100" fill="url(#grid-architect)" />
        
        <!-- Connecting paths -->
        <path 
          d="M 25 30 H 75 V 70 H 25 Z" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="1.2" 
          stroke-dasharray="3 3" 
          class="stroke-muted-foreground/40 group-hover:stroke-primary/50 transition-colors duration-300 flow-line" 
        />
        <path 
          d="M 25 30 H 75" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="1.2" 
          class="stroke-muted-foreground/60 group-hover:stroke-primary/70 transition-colors duration-300" 
        />
        <path 
          d="M 75 70 H 25" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="1.2" 
          class="stroke-muted-foreground/60 group-hover:stroke-primary/70 transition-colors duration-300" 
        />
        
        <!-- Interactive node dots -->
        <circle cx="75" cy="30" r="2.5" class="fill-primary/20 stroke-primary/60 stroke-[1px] group-hover:fill-indigo-500/30 group-hover:stroke-indigo-500 transition-all duration-300" />
        <circle cx="25" cy="70" r="2.5" class="fill-primary/20 stroke-primary/60 stroke-[1px] group-hover:fill-emerald-500/30 group-hover:stroke-emerald-500 transition-all duration-300" />

        <!-- Node 1 -->
        <g class="node-element transition-transform duration-300 group-hover:-translate-y-0.5">
          <rect x="10" y="20" width="30" height="20" rx="3" fill="var(--background)" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground group-hover:stroke-primary transition-colors" />
          <circle cx="16" cy="27" r="2" class="fill-emerald-500" />
          <line x1="22" y1="27" x2="34" y2="27" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground/40 group-hover:stroke-primary/30" />
          <line x1="16" y1="33" x2="34" y2="33" stroke="currentColor" stroke-width="1" class="stroke-muted-foreground/20 group-hover:stroke-primary/20" />
        </g>

        <!-- Node 2 (Active/AI) -->
        <g class="node-element transition-transform duration-300 group-hover:translate-x-0.5">
          <rect x="60" y="40" width="30" height="20" rx="3" fill="var(--background)" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground group-hover:stroke-indigo-500 transition-colors" />
          <circle cx="66" cy="47" r="2" class="fill-indigo-500 animate-pulse" />
          <line x1="72" y1="47" x2="84" y2="47" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground/40 group-hover:stroke-indigo-500/30" />
          <line x1="66" y1="53" x2="84" y2="53" stroke="currentColor" stroke-width="1" class="stroke-muted-foreground/20 group-hover:stroke-indigo-500/20" />
        </g>

        <!-- Node 3 -->
        <g class="node-element transition-transform duration-300 group-hover:translate-y-0.5">
          <rect x="10" y="60" width="30" height="20" rx="3" fill="var(--background)" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground group-hover:stroke-primary transition-colors" />
          <circle cx="16" cy="67" r="2" class="fill-neutral-400 dark:fill-neutral-600" />
          <line x1="22" y1="67" x2="34" y2="67" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground/40 group-hover:stroke-primary/30" />
          <line x1="16" y1="73" x2="34" y2="73" stroke="currentColor" stroke-width="1" class="stroke-muted-foreground/20 group-hover:stroke-primary/20" />
        </g>
      </svg>
    )
  }

  {
    id === "bytebox" && (
      <svg viewBox="0 0 100 100" class="w-full h-full text-muted-foreground group-hover:text-primary transition-colors duration-300">
        <defs>
          <pattern id="grid-bytebox" width="10" height="10" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1" class="fill-muted-foreground/15 dark:fill-muted-foreground/10" />
          </pattern>
        </defs>
        
        <rect width="100" height="100" fill="url(#grid-bytebox)" />
        
        <!-- Flow / Upload paths -->
        <path 
          d="M 20 30 C 20 30, 45 15, 65 32" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="1.2" 
          stroke-dasharray="3 3" 
          class="stroke-muted-foreground/40 group-hover:stroke-sky-500/50 transition-colors flow-line" 
        />
        
        <!-- Storage Vault/Box isometric -->
        <g class="box-group transition-transform duration-300 group-hover:scale-[1.02] origin-center">
          <path 
            d="M 25 48 L 50 38 L 75 48 L 75 75 L 50 85 L 25 75 Z" 
            fill="var(--background)" 
            stroke="currentColor" 
            stroke-width="1.5" 
            class="stroke-muted-foreground group-hover:stroke-primary transition-colors" 
          />
          <line x1="50" y1="38" x2="50" y2="85" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground/70 group-hover:stroke-primary/70" />
          <line x1="25" y1="48" x2="50" y2="58" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground/70 group-hover:stroke-primary/70" />
          <line x1="75" y1="48" x2="50" y2="58" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground/70 group-hover:stroke-primary/70" />
          
          <!-- Inner data blocks / folder cards -->
          <rect 
            x="36" y="48" width="28" height="16" 
            transform="rotate(-12 50 56)" 
            fill="var(--background)" 
            stroke="currentColor" 
            stroke-width="1" 
            class="stroke-sky-500/70 group-hover:stroke-sky-500 transition-colors" 
          />
          <rect 
            x="39" y="50" width="22" height="12" 
            transform="rotate(-12 50 56)" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="0.8" 
            stroke-dasharray="2 1"
            class="stroke-sky-500/30 group-hover:stroke-sky-500/40" 
          />
        </g>
        
        <!-- Telegram paper plane flying in -->
        <path 
          d="M 68 24 L 84 18 L 76 32 L 73 28 Z" 
          fill="var(--background)" 
          stroke="currentColor" 
          stroke-width="1.2" 
          class="stroke-muted-foreground group-hover:stroke-sky-400 group-hover:translate-x-[-3px] group-hover:translate-y-[3px] transition-all duration-300 plane-item" 
        />
        <line 
          x1="73" y1="28" x2="84" y2="18" 
          stroke="currentColor" 
          stroke-width="0.8" 
          class="stroke-muted-foreground/60 group-hover:stroke-sky-400 transition-colors plane-item" 
        />
      </svg>
    )
  }

  {
    id === "vibe-chat-app" && (
      <svg viewBox="0 0 100 100" class="w-full h-full text-muted-foreground group-hover:text-primary transition-colors duration-300">
        <defs>
          <pattern id="grid-vibe" width="10" height="10" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1" class="fill-muted-foreground/15 dark:fill-muted-foreground/10" />
          </pattern>
        </defs>
        
        <rect width="100" height="100" fill="url(#grid-vibe)" />
        
        <!-- Chat Frame / Device shape -->
        <rect 
          x="15" y="15" width="70" height="70" rx="5" 
          fill="var(--background)" 
          stroke="currentColor" 
          stroke-width="1.5" 
          class="stroke-muted-foreground group-hover:stroke-primary transition-colors duration-300" 
        />
        <line x1="15" y1="28" x2="85" y2="28" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground/60 group-hover:stroke-primary/60" />
        
        <!-- Header details -->
        <circle cx="23" cy="21.5" r="2.2" class="fill-red-500/80" />
        <circle cx="29" cy="21.5" r="2.2" class="fill-yellow-500/80" />
        <circle cx="35" cy="21.5" r="2.2" class="fill-green-500/80" />
        
        <!-- Video camera silhouette inside top header (WebRTC) -->
        <g class="transition-colors duration-300 text-muted-foreground/80 group-hover:text-emerald-500">
          <path d="M 64 18 L 70 18 L 70 25 L 64 25 Z" fill="none" stroke="currentColor" stroke-width="1" />
          <path d="M 70 20 L 74 18 L 74 25 L 70 23 Z" fill="none" stroke="currentColor" stroke-width="1" />
        </g>
        
        <!-- Pulse / Presence dot -->
        <circle cx="80" cy="21.5" r="2.2" class="fill-emerald-500" />
        <circle cx="80" cy="21.5" r="4.5" class="stroke-emerald-500/40 fill-none stroke-[0.8px] pulse-ring" />

        <!-- Speech bubble 1 (Left - Indigo/Accent) -->
        <g class="bubble-left transition-transform duration-300 group-hover:translate-x-0.5">
          <rect x="22" y="35" width="38" height="18" rx="4" fill="var(--background)" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground group-hover:stroke-indigo-400 transition-colors" />
          <!-- bubble arrow pointer -->
          <path d="M 22 41 L 18 44 L 22 47 Z" fill="var(--background)" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground group-hover:stroke-indigo-400 transition-colors" />
          <!-- soundwave lines (Socket.io/webrtc) -->
          <line x1="28" y1="44" x2="28" y2="44" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="stroke-indigo-400 wave-bar-1" />
          <line x1="33" y1="41" x2="33" y2="47" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="stroke-indigo-400 wave-bar-2" />
          <line x1="38" y1="39" x2="38" y2="49" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="stroke-indigo-400 wave-bar-3" />
          <line x1="43" y1="42" x2="43" y2="46" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="stroke-indigo-400 wave-bar-4" />
          <line x1="48" y1="44" x2="54" y2="44" stroke="currentColor" stroke-width="1" class="stroke-muted-foreground/30 group-hover:stroke-indigo-400/40" />
        </g>
        
        <!-- Speech bubble 2 (Right - Message text) -->
        <g class="bubble-right transition-transform duration-300 group-hover:-translate-x-0.5">
          <rect x="40" y="58" width="38" height="18" rx="4" fill="var(--background)" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground group-hover:stroke-primary transition-colors" />
          <path d="M 78 64 L 82 67 L 78 70 Z" fill="var(--background)" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground group-hover:stroke-primary transition-colors" />
          
          <line x1="46" y1="64" x2="72" y2="64" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground/60 group-hover:stroke-primary/60" />
          <line x1="46" y1="70" x2="64" y2="70" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground/40 group-hover:stroke-primary/40" />
        </g>
      </svg>
    )
  }

  {
    id !== "architect-io" && id !== "bytebox" && id !== "vibe-chat-app" && (
      <svg viewBox="0 0 100 100" class="w-full h-full text-muted-foreground group-hover:text-primary transition-colors duration-300">
        <defs>
          <pattern id="grid-default" width="10" height="10" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1" class="fill-muted-foreground/15 dark:fill-muted-foreground/10" />
          </pattern>
        </defs>
        
        <rect width="100" height="100" fill="url(#grid-default)" />
        
        <!-- General code file template -->
        <rect 
          x="20" y="15" width="60" height="70" rx="4" 
          fill="var(--background)" 
          stroke="currentColor" 
          stroke-width="1.5" 
          class="stroke-muted-foreground group-hover:stroke-primary transition-colors duration-300" 
        />
        
        <!-- Folded page corner effect -->
        <path d="M 68 15 L 80 27 L 68 27 Z" fill="var(--background)" stroke="currentColor" stroke-width="1.5" class="stroke-muted-foreground group-hover:stroke-primary transition-colors duration-300" />
        
        <!-- Lines of code -->
        <line x1="28" y1="35" x2="55" y2="35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="stroke-muted-foreground/60 group-hover:stroke-primary/60" />
        <line x1="28" y1="43" x2="72" y2="43" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="stroke-muted-foreground/40 group-hover:stroke-primary/40" />
        <line x1="28" y1="51" x2="64" y2="51" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="stroke-muted-foreground/40 group-hover:stroke-primary/40" />
        <line x1="28" y1="59" x2="48" y2="59" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="stroke-muted-foreground/60 group-hover:stroke-primary/60" />
        
        <!-- Tags / brackets </> -->
        <path d="M 32 68 L 26 73 L 32 78" fill="none" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground/80 group-hover:stroke-primary transition-colors" />
        <path d="M 68 68 L 74 73 L 68 78" fill="none" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground/80 group-hover:stroke-primary transition-colors" />
        <line x1="52" y1="67" x2="48" y2="79" stroke="currentColor" stroke-width="1.2" class="stroke-muted-foreground/80 group-hover:stroke-primary transition-colors" />
      </svg>
    )
  }
</div>

<style>
  /* SVG micro-animations on hover */
  .group:hover .flow-line {
    animation: flow-dash 10s linear infinite;
  }
  
  @keyframes flow-dash {
    to {
      stroke-dashoffset: -40;
    }
  }

  .pulse-ring {
    animation: ring-pulse 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    transform-origin: 80px 21.5px;
  }

  @keyframes ring-pulse {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  /* Soundwave animations in Vibe Chat */
  .group:hover .wave-bar-1 {
    animation: wave-play 0.6s ease-in-out infinite alternate;
    transform-origin: 28px 44px;
  }
  .group:hover .wave-bar-2 {
    animation: wave-play 0.8s ease-in-out infinite alternate 0.1s;
    transform-origin: 33px 44px;
  }
  .group:hover .wave-bar-3 {
    animation: wave-play 0.5s ease-in-out infinite alternate 0.2s;
    transform-origin: 38px 44px;
  }
  .group:hover .wave-bar-4 {
    animation: wave-play 0.7s ease-in-out infinite alternate 0.15s;
    transform-origin: 43px 44px;
  }

  @keyframes wave-play {
    0% {
      transform: scaleY(0.4);
    }
    100% {
      transform: scaleY(1.3);
    }
  }

  /* Bytebox Airplane hover */
  .group:hover .plane-item {
    animation: plane-fly 1.2s ease-in-out infinite alternate;
  }

  @keyframes plane-fly {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(-4px, 4px);
    }
  }
</style>
