---
import { ChevronRightIcon } from "lucide-react";

import MarkdownRenderer from "@/components/ui/markdown-renderer.astro";
import type { CollectionEntry } from "astro:content";
import Badge from "@/components/ui/badge.astro";
import { basePath } from "@/lib/utils";
import ProjectThumbnail from "./project-thumbnail.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<a
  href={basePath(`/projects/${project.id}`)}
  class="group flex flex-col sm:flex-row cursor-pointer items-stretch not-last:border-b hover:bg-muted/5 transition-colors duration-200"
>
  <ProjectThumbnail id={project.id} />

  <div class="flex w-full flex-col gap-y-3 p-4">
    <div class="flex w-full items-center justify-between text-left select-none">
      <h3
        class="text-lg font-semibold underline-offset-6 group-hover:underline"
      >
        {project.data.name}
      </h3>

      <ChevronRightIcon
        className="size-4 shrink-0 text-muted-foreground transition-transform duration-150 group-hover:translate-x-1"
      />
    </div>

    <MarkdownRenderer
      className="text-xs leading-5 font-medium md:text-sm text-muted-foreground group-hover:text-foreground transition-colors duration-200"
      content={project.data.description}
    />

    {
      project.data.technologies.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {project.data.technologies.map(technology => {
            return <Badge>{technology}</Badge>;
          })}
        </div>
      )
    }
  </div>
</a>

