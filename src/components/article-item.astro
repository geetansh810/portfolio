---
import type { CollectionEntry } from "astro:content";
import { ChevronRightIcon, NotebookPen } from "lucide-react";
import getReadingTime from "reading-time";
import { basePath } from "@/lib/utils";

interface Props {
  article: CollectionEntry<"blog">;
}

const { article } = Astro.props;

const isExternal = article.data.link !== undefined;
const href = isExternal ? article.data.link : basePath(`/articles/${article.id}`);

const formattedDate = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
}).format(article.data.pubDatetime);
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class="group flex w-full cursor-pointer items-center py-2"
>
  {
    article.data.image ? (
      <img
        src={article.data.image}
        alt={article.data.title}
        class="mx-5 size-14 shrink-0 rounded-md object-cover border border-border transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="mx-5 flex size-14 shrink-0 items-center justify-center rounded-md border border-dashed border-border bg-muted/20 transition-colors duration-300 group-hover:bg-muted/40">
        <NotebookPen className="size-5 shrink-0 text-muted-foreground transition-transform duration-300 group-hover:scale-110" />
      </div>
    )
  }

  <div
    class="flex flex-1 flex-col items-start justify-center gap-3 border-l p-4"
  >
    <div class="flex w-full items-center justify-between text-left select-none">
      <h3
        class="text-lg font-semibold underline-offset-6 group-hover:underline"
      >
        {article.data.title}
      </h3>

      <ChevronRightIcon
        className="size-4 shrink-0 text-sm text-muted-foreground transition-transform duration-150 group-hover:translate-x-1"
      />
    </div>

    <ul class="flex flex-wrap items-center justify-start gap-x-4">
      {
        article.data.tags.map(tag => (
          <li class="text-xs font-semibold">#{tag}</li>
        ))
      }
    </ul>
    <p class="text-xs text-foreground">
      {formattedDate} | {getReadingTime(article.body!).text}
    </p>
  </div>
</a>
